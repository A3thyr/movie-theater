{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",

  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",

  "sortImports": true,

  "sortTailwindcss": {
    "stylesheet": "./src/app/globals.css",
    "functions": ["cn", "clsx", "cva"]
  },

  "sortPackageJson": true
}
